{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "no-title",
			"postTypes": ["post", "page"],
			"title": "No title"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"palette": [
				{
					"color": "#f1f2f3",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#e7e9eb",
					"name": "Base Smoke",
					"slug": "base-smoke"
				},
				{
					"color": "#FFF3E2",
					"name": "Base Soft",
					"slug": "base-soft"
				},
				{
					"color": "#2b2b2b",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#eb8900",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#0062eb",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#C5E2FC",
					"name": "Accent Soft",
					"slug": "accent-soft"
				},
				{
					"color": "transparent",
					"name": "Transparent",
					"slug": "transparent"
				}
			]
		},
		"layout": {
			"contentSize": "75rem",
			"wideSize": "87.5rem"
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "4px",
					"size": "0.25rem",
					"slug": "4"
				},
				{
					"name": "8px",
					"size": "0.5rem",
					"slug": "8"
				},
				{
					"name": "12px",
					"size": "0.75rem",
					"slug": "12"
				},
				{
					"name": "16px",
					"size": "1rem",
					"slug": "16"
				},
				{
					"name": "24px",
					"size": "1.5rem",
					"slug": "24"
				},
				{
					"name": "32px",
					"size": "2rem",
					"slug": "32"
				},
				{
					"name": "48px",
					"size": "3rem",
					"slug": "48"
				},
				{
					"name": "64px",
					"size": "4rem",
					"slug": "64"
				},
				{
					"name": "72px",
					"size": "4.5rem",
					"slug": "72"
				},
				{
					"name": "80px",
					"size": "5rem",
					"slug": "80"
				},
				{
					"name": "96px",
					"size": "6rem",
					"slug": "96"
				},
				{
					"name": "120px",
					"size": "7.5rem",
					"slug": "120"
				}
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"letterSpacing": true,
			"fontFamilies": [
				{
					"fontFamily": "\"IBM Plex Sans\", sans-serif",
					"name": "IBM Plex Sans",
					"slug": "ibm-plex-sans",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "300",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/ibm-plex-sans-v23-latin/ibm-plex-sans-v23-latin-300.woff2"
							]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/ibm-plex-sans-v23-latin/ibm-plex-sans-v23-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "500",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/ibm-plex-sans-v23-latin/ibm-plex-sans-v23-latin-500.woff2"
							]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/ibm-plex-sans-v23-latin/ibm-plex-sans-v23-latin-600.woff2"
							]
						}
					]
				},
				{
					"name": "Barlow Condensed",
					"slug": "barlow-condensed",
					"fontFamily": "\"Barlow Condensed\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "100",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-100.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "200",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-200.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "300",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-300.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-500.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-600.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-700.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "800",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-800.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "900",
							"src": [
								"file:./assets/fonts/barlow-condensed-v13-latin/barlow-condensed-v13-latin-900.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "XS",
					"size": "0.8rem",
					"slug": "x-small"
				},
				{
					"fluid": false,
					"name": "SM",
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "MD",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.25rem",
						"max": "1.563rem"
					},
					"name": "LG",
					"size": "1.563rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.563rem",
						"max": "1.953rem"
					},
					"name": "XL",
					"size": "1.953rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "1.953rem",
						"max": "2.441rem"
					},
					"name": "2XL",
					"size": "2.441rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"min": "2.441rem",
						"max": "3.052rem"
					},
					"name": "3XL",
					"size": "3.052rem",
					"slug": "xxx-large"
				},
				{
					"fluid": {
						"min": "3.052rem",
						"max": "3.815rem"
					},
					"name": "4XL",
					"size": "3.815rem",
					"slug": "display"
				},
				{
					"fluid": {
						"min": "3.815rem",
						"max": "4.768rem"
					},
					"name": "5XL",
					"size": "4.768rem",
					"slug": "display-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"blockGap": "0"
		},
		"blocks": {
			"core/code": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/navigation": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--24)"
				}
			},
			"core/heading": {
				"typography": {
					"textTransform": "none"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--8)"
					}
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			}
		},

		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--8)",
						"right": "var(--wp--preset--spacing--16)",
						"bottom": "var(--wp--preset--spacing--8)",
						"left": "var(--wp--preset--spacing--16)"
					}
				},

				"border": {
					"radius": "8px"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow-condensed)"
				}
			},
			"h2": {
				"typography": {
					"lineHeight": "1.00",
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--8)"
					}
				}
			},
			"h3": {
				"typography": {
					"lineHeight": "1.00",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--8)"
					}
				}
			}
		},

		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
