{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "no-title",
			"postTypes": ["post", "page"],
			"title": "No title"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"palette": [
				{
					"color": "#f1f2f3",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#FFF3E2",
					"name": "Base Soft",
					"slug": "base-soft"
				},
				{
					"color": "#2b2b2b",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#eb8900",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#0062eb",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#FFE8C8",
					"name": "Accent Soft",
					"slug": "accent-soft"
				},
				{
					"color": "transparent",
					"name": "Transparent",
					"slug": "transparent"
				}
			]
		},
		"layout": {
			"contentSize": "700px",
			"wideSize": "1100px"
		},
		"spacing": {
			"spacingSizes": [
				{ "name": "4px", "size": "0.25rem", "slug": "4" },
				{ "name": "8px", "size": "0.5rem", "slug": "8" },
				{ "name": "12px", "size": "0.75rem", "slug": "12" },
				{ "name": "16px", "size": "1rem", "slug": "16" },
				{ "name": "24px", "size": "1.5rem", "slug": "24" },
				{ "name": "32px", "size": "2rem", "slug": "32" },
				{ "name": "48px", "size": "3rem", "slug": "48" },
				{ "name": "64px", "size": "4rem", "slug": "64" },
				{ "name": "72px", "size": "4.5rem", "slug": "72" },
				{ "name": "80px", "size": "5rem", "slug": "80" }
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"letterSpacing": true,
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/inter-v20-latin/inter-v20-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/inter-v20-latin/inter-v20-latin-600.woff2"
							]
						}
					]
				},
				{
					"name": "Oswald",
					"slug": "oswald",
					"fontFamily": "\"Oswald\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "200",
							"src": [
								"file:./assets/fonts/oswald-v57-latin/oswald-v57-latin-200.woff2"
							]
						},
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "300",
							"src": [
								"file:./assets/fonts/oswald-v57-latin/oswald-v57-latin-300.woff2"
							]
						},
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/oswald-v57-latin/oswald-v57-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/oswald-v57-latin/oswald-v57-latin-500.woff2"
							]
						},
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/oswald-v57-latin/oswald-v57-latin-600.woff2"
							]
						},
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/oswald-v57-latin/oswald-v57-latin-700.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Extra Small",
					"size": "0.8rem",
					"slug": "x-small"
				},
				{ "fluid": false, "name": "Small", "size": "1rem", "slug": "small" },
				{
					"fluid": false,
					"name": "Medium",
					"size": "1.25rem",
					"slug": "medium"
				},
				{
					"fluid": { "min": "1.25rem", "max": "1.563rem" },
					"name": "Large",
					"size": "1.563rem",
					"slug": "large"
				},
				{
					"fluid": { "min": "1.563rem", "max": "1.953rem" },
					"name": "XL",
					"size": "1.953rem",
					"slug": "x-large"
				},
				{
					"fluid": { "min": "1.953rem", "max": "2.441rem" },
					"name": "XXL",
					"size": "2.441rem",
					"slug": "xx-large"
				},
				{
					"fluid": { "min": "2.441rem", "max": "3.052rem" },
					"name": "Hero",
					"size": "3.052rem",
					"slug": "hero"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"blockGap": "0"
		},
		"blocks": {
			"core/code": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/navigation": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--24)"
				}
			}
		},

		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--8)",
						"right": "var(--wp--preset--spacing--16)",
						"bottom": "var(--wp--preset--spacing--8)",
						"left": "var(--wp--preset--spacing--16)"
					}
				},
				"border": {
					"radius": "8px"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
